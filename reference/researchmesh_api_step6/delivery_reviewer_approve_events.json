        "agreement_json": "{\"agreement_hash\": \"d54ddd0c5f6580b21500fcf25138deac79d6243dc660fe2844f5466f30ff679d\", \"current_version\": 2, \"deliverables\": [{\"acceptance\": \"交付一个可运行的CSV清洗脚本，附带示例输入文件和示例输出文件，说明脚本如何处理缺失值和异常数据。验收时通过运行脚本验证输出是否符合示例输出，并核对处理规则文档。\", \"id\": \"D1\", \"text\": \"CSV清洗脚本与样例输出\"}, {\"acceptance\": \"交付趋势图和说明文档。说明文档需包含一条趋势观察和一条图表局限性，且说明内容限定在120字以内。验收时核对趋势图是否与提供的数据一致，检查说明是否符合字数和内容要求。\", \"id\": \"D2\", \"text\": \"趋势图与说明\"}], \"demo_only\": true, \"formal_state_update\": false, \"id\": \"ENG-API-DEMO-06\", \"identity_verified\": false, \"owner_accepted\": true, \"performer_accepted\": true, \"performer_id\": \"P-DEMO\", \"reviewer_id\": \"R-DEMO\", \"state\": \"in_progress\", \"submission_version\": 2, \"version\": 2, \"source_workflow_run_id\": \"b8b5059d-53b3-4322-a20e-67bebe1c4bd2\"}",
